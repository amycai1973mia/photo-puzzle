rules_version = '2';
// 草稿：默认全部拒绝；登录用户只能读写自己的数据；levels 公开只读（游客也能看关卡目录）
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /progress/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /levels/{id} {
      allow read: if true;
      allow write: if false; // 只在 Console 里手动维护
    }
    // V1.10 旧试玩链接：V1.13 起不再使用；只保留读取（旧链接无害），不再允许新建
    match /trials/{token} {
      allow get: if true;
    }
    // V1.13 分享一张拼图：只存这一张压缩照片 + 难度 + 文字，不存 uid/名字/邮箱
    // 知道 token 才能读，过期后读不到；登录用户才能新建（不记录是谁），最长7天，不能改删
    match /shares/{token} {
      allow get: if resource.data.expiresAt > request.time.toMillis();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['img','grid','labels','createdAt','expiresAt','deleteAt'])
        && request.resource.data.deleteAt is timestamp
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.grid in [6,12,20,30,48]
        && request.resource.data.labels is string && request.resource.data.labels.size() <= 110
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int && request.resource.data.expiresAt <= request.time.toMillis() + 7*86400000 + 600000;
    }
    // V1.15 反馈墙：公开可读（只有昵称/星级/文字/回复，没有邮箱和 uid）；任何人可新建评价或提问；
    // 回复(reply/replyAt)只能由 Amy 在 Firebase Console 里添加（Console 不受规则限制），App 里不能改删。
    // 旧 V1.10 记录没有 kind 字段（含 uid），不公开。
    match /feedback/{id} {
      allow read: if resource.data.kind in ['rating', 'ask'];
      allow create: if request.resource.data.keys().hasOnly(['stars','text','displayName','kind','n','grid','ms','lang','createdAt'])
        && request.resource.data.kind in ['rating', 'ask']
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
        && (request.resource.data.kind == 'ask' || request.resource.data.stars >= 1)
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && (request.resource.data.kind == 'rating' || request.resource.data.text.size() >= 2)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 20
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
  }
}
