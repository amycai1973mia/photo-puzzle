rules_version = '2';
// Family Photo Puzzle — Admin V1 草稿规则（本机已更新；线上需发布时 deploy）
// 管理员邮箱写死在 isAdmin()；与 firebase-config.js 的 ADMIN_EMAILS 保持同步。
// Assumed models:
//   users/{uid}: { uid, email, displayName, locale, createdAt, updatedAt, best_g*, lastLoginAt? }
//   progress/{userId_puzzleId}: { userId, puzzleId, n, pos, correct, playMs, done, bestMs, updatedAt, ... }
//   feedback/{id}: { kind: rating|ask|hidden_rating|hidden_ask, stars, text, displayName, n, grid, ms, lang, createdAt,
//                    reply?, replyAt?, hidden?, hiddenAt? }  — 无 uid/邮箱
//   shares/{token}: { img, grid, labels, createdAt, expiresAt, deleteAt }
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    // 管理员：仅 Amy 的登录邮箱。新增管理员时改这里 + firebase-config.js ADMIN_EMAILS。
    // 注：邮箱密码账号未必 email_verified；以邮箱白名单为准（不开放自助升权）。
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in ['amycai1973@gmail.com'];
    }
    function feedbackPublicKind() {
      return resource.data.kind in ['rating', 'ask'];
    }
    function feedbackModKind() {
      return request.resource.data.kind in ['rating', 'ask', 'hidden_rating', 'hidden_ask'];
    }

    match /{document=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      // Admin V1 总览：数注册用户 / 近7日有云端活动
      allow read: if isAdmin();
    }
    match /progress/{docId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
    match /levels/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /trials/{token} {
      allow get: if true;
    }
    match /shares/{token} {
      allow get: if resource.data.expiresAt > request.time.toMillis() || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['img','grid','labels','createdAt','expiresAt','deleteAt'])
        && request.resource.data.deleteAt is timestamp
        && request.resource.data.img is string && request.resource.data.img.size() < 900000
        && request.resource.data.img.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.grid in [6,12,20,30,48]
        && request.resource.data.labels is string && request.resource.data.labels.size() <= 110
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int && request.resource.data.expiresAt <= request.time.toMillis() + 7*86400000 + 600000;
    }
    // 反馈墙：公开只读 rating|ask；软隐藏改 kind→hidden_*（公开查询自然看不到）
    // 回复/隐藏/删除：仅管理员（或 Firebase Console）
    match /feedback/{id} {
      allow read: if isAdmin() || feedbackPublicKind();
      allow create: if request.resource.data.keys().hasOnly(['stars','text','displayName','kind','n','grid','ms','lang','createdAt'])
        && request.resource.data.kind in ['rating', 'ask']
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
        && (request.resource.data.kind == 'ask' || request.resource.data.stars >= 1)
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && (request.resource.data.kind == 'rating' || request.resource.data.text.size() >= 2)
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 20
        && request.resource.data.createdAt is int;
      allow update: if isAdmin()
        && feedbackModKind()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reply', 'replyAt', 'kind', 'hidden', 'hiddenAt'])
        && (!('reply' in request.resource.data) || (request.resource.data.reply is string && request.resource.data.reply.size() <= 500))
        && (!('replyAt' in request.resource.data) || request.resource.data.replyAt is int)
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && (!('hiddenAt' in request.resource.data) || request.resource.data.hiddenAt is int);
      allow delete: if isAdmin();
    }
  }
}
