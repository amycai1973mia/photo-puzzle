rules_version = '2';
// 草稿：默认全部拒绝；登录用户只能读写自己的数据；levels 公开只读（游客也能看关卡目录）
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /progress/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /levels/{id} {
      allow read: if true;
      allow write: if false; // 只在 Console 里手动维护
    }
    // V1.10 试玩链接：任何人可按链接读取；登录用户只能创建自己的，最长7天，不能改删
    match /trials/{token} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['createdBy','createdAt','expiresAt'])
        && request.resource.data.expiresAt is int && request.resource.data.expiresAt <= request.time.toMillis() + 7*86400000 + 600000;
    }
    // V1.10 反馈：任何人只能新建（不能读/改/删），星级1–5，文字≤100字
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['stars','text','n','grid','ms','lang','uid','at'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 100;
    }
  }
}
